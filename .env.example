# ----------------------------------------------------------------------
# PickMi Driver & Admin Supabase Configuration
# ----------------------------------------------------------------------
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy "Project URL" and paste into EXPO_PUBLIC_SUPABASE_URL
# 4. Copy "anon public" key and paste into EXPO_PUBLIC_SUPABASE_ANON_KEY
# ----------------------------------------------------------------------

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Razorpay Live / Test Gateway Credentials
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx

# 2Factor.in SMS Gateway Configuration (https://2factor.in)
EXPO_PUBLIC_TWOFACTOR_API_KEY=your-2factor-api-key-here
EXPO_PUBLIC_TWOFACTOR_OTP_TEMPLATE=

