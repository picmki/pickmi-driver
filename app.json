{
  "expo": {
    "name": "Pickmi Driver",
    "slug": "pickmi-driver",
    "owner": "karthik761346",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/driver_icon.png",
    "scheme": "pickmidriver",
    "userInterfaceStyle": "light",
    "primaryColor": "#0043DC",
    "splash": {
      "image": "./assets/pickmi_logo.png",
      "backgroundColor": "#0043DC",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pickmi.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PickMi Driver requires your location to display pickup and drop-off navigation routes."
      }
    },
    "android": {
      "package": "com.pickmi.driver",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0043DC",
        "foregroundImage": "./assets/driver_icon_foreground.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "SYSTEM_ALERT_WINDOW",
        "USE_FULL_SCREEN_INTENT",
        "FOREGROUND_SERVICE"
      ],
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "*.pickmi.com",
              "pathPrefix": "/driver"
            },
            {
              "scheme": "pickmidriver"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/driver_icon.png",
          "color": "#0043DC",
          "sounds": []
        }
      ]
    ],
    "web": {
      "favicon": "./assets/driver_icon.png",
      "bundler": "metro"
    },
    "newArchEnabled": false,
    "extra": {
      "eas": {
        "projectId": "13fe6dc0-ca34-419b-9d8c-de3b788bdcb0"
      },
      "supabaseUrl": "https://awwrbgwpzgtbunrvsmyu.supabase.co",
      "supabaseAnonKey": "sb_publishable_MVv7fXTjS6R79oXLOHuCLA_ij0lDSRE"
    }
  }
}
