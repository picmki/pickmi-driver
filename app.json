{
  "expo": {
    "name": "Pickmi Driver",
    "slug": "MobileApp",
    "version": "1.0.16",
    "orientation": "portrait",
    "icon": "./assets/driver_icon.png",
    "scheme": "pickmidriver",
    "userInterfaceStyle": "light",
    "primaryColor": "#0043DC",
    "splash": {
      "image": "./assets/pickmi_logo.png",
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pickmi.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PickMi Driver requires your location to display pickup and drop-off navigation routes."
      }
    },
    "android": {
      "package": "com.pickmi.driver",
      "versionCode": 17,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0043DC",
        "foregroundImage": "./assets/driver_icon_foreground.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "SYSTEM_ALERT_WINDOW",
        "USE_FULL_SCREEN_INTENT",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "FOREGROUND_SERVICE_DATA_SYNC"
      ],
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "*.pickmi.com",
              "pathPrefix": "/driver"
            },
            {
              "scheme": "pickmidriver"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/driver_icon.png",
          "color": "#0043DC",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Pickmi Driver collects location data to enable real-time trip matching, pickup dispatching, turn-by-turn navigation, and driver safety even when the app is closed or not in use.",
          "locationAlwaysPermission": "Pickmi Driver collects location data to enable real-time trip matching, pickup dispatching, turn-by-turn navigation, and driver safety even when the app is closed or not in use.",
          "locationWhenInUsePermission": "Pickmi Driver collects location data to enable real-time trip matching, pickup dispatching, and turn-by-turn navigation.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "web": {
      "favicon": "./assets/driver_icon.png",
      "bundler": "metro"
    },
    "newArchEnabled": false,
    "extra": {
      "eas": {
        "projectId": "4ecc15ea-142d-4f0b-a354-66c2cbb829d3"
      },
      "supabaseUrl": "https://awwrbgwpzgtbunrvsmyu.supabase.co",
      "supabaseAnonKey": "sb_publishable_MVv7fXTjS6R79oXLOHuCLA_ij0lDSRE"
    },
    "sdkVersion": "51.0.0"
  }
}
